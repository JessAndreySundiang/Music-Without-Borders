{
  "name": "music-without-borders",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "save-local": "node scripts/bootstrap.mjs --save-local",
    "postinstall": "node scripts/bootstrap.mjs --postinstall",
    "dev": "node scripts/dev.mjs",
    "dev:mysql": "node scripts/dev.mjs --mysql",
    "dev:sqlite": "node scripts/dev.mjs --sqlite",
    "dev:web": "vite",
    "dev:api": "node server/server.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ledger": "node scripts/donations-report.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
